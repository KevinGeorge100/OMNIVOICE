# Run `omnivoice init` to generate a private local .env and administrator token.
OMNI_ADMIN_TOKEN=
OMNI_DATABASE=data/omnivoice.db
OMNI_PUBLIC_BASE_URL=
OMNI_SARVAM_API_KEY=
OMNI_GROQ_API_KEY=
OMNI_GROQ_MODEL=llama-3.1-8b-instant
OMNI_STT_MODEL=saaras:v3-realtime
OMNI_TTS_MODEL=bulbul:v3
OMNI_TTS_SPEAKER=shubh
OMNI_SILERO_MODEL=models/silero_vad.onnx
OMNI_SEMANTIC_ENABLED=false
OMNI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OMNI_EXOTEL_ACCOUNT_SID=
OMNI_EXOTEL_API_KEY=
OMNI_EXOTEL_API_TOKEN=
OMNI_TWILIO_ACCOUNT_SID=
OMNI_TWILIO_AUTH_TOKEN=
OMNI_ENABLE_OUTBOUND=false
